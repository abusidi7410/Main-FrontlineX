# Frontline Nexus — Frontend environment configuration
#
# This file documents the required environment variables for the frontend build.
# Copy to .env.local (or .env in CI) and set values as needed.
#
# VITE_* variables are embedded into the client bundle at build time.

# API base URL. In production this points at the Django REST backend.
# The Django project mounts every app under /api/v1, so the base URL must end
# with /api/v1 — see src/api/client.ts (API_PREFIX) and backend/config/urls.py.
# Example: https://api.frontlinenexus.com/api/v1
# Default (when omitted): "/api/v1" (relative to the app origin).
VITE_API_URL=/api/v1

# Switch the HTTP client adapter.
# "mock" (or any value other than "live") → use the in-memory mock adapter (default).
# "live"     → hit the real REST API via VITE_API_URL.
VITE_API_MODE=mock
